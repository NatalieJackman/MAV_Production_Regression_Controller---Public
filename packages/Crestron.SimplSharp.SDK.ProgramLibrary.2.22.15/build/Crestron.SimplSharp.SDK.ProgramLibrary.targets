<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<ArchiveDependencyExtension>.clz</ArchiveDependencyExtension>
	</PropertyGroup>
	<Target Name="SimplSharpAfterBuild" BeforeTargets="AfterBuild">
		<MSBuild Projects="$(MSBuildProjectFile)" Targets="SimplSharpClean" />
	</Target>
	<Target Name="SimplSharpAfterClean" AfterTargets="AfterClean">
		<MSBuild Projects="$(MSBuildProjectFile)" Targets="SimplSharpClean" />
	</Target>
	<Target Name="SimplSharpClean">
		<Delete Files="$(OutputPath)\ProgramInfo.config" ContinueOnError="true"/>
		<Delete Files="$(OutputPath)\$(TargetName)$(ArchiveDependencyExtension)" ContinueOnError="true"/>
	</Target>
</Project>